TEST_MODE=true
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=psycho01_local
DB_USER=psycho_local
DB_PASS=replace-with-local-password
# For the isolated PostgreSQL Docker container; keep these equal to DB_* above.
POSTGRES_USER=psycho_local
POSTGRES_DB=psycho01_local
POSTGRES_PASSWORD=replace-with-local-password
JWT_SECRET=replace-with-random-secret
REG_CODE_SECRET=replace-with-another-random-secret
FRONTEND_URL=http://127.0.0.1:8000
BILLING_CURRENCY=RUB
BILLING_TIMEZONE=Europe/Moscow
SUBSCRIPTION_PRICE_MINOR=99000
SUBSCRIPTION_DAYS=30
AI_FREE_DAILY_LIMIT=3
BOOKING_HOLD_MINUTES=15
# Real payments stay disabled until accounts, tax basis and fee settings are configured.
BILLING_LIVE_ENABLED=false
